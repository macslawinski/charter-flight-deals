---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/atkinson-hyperlegible-next/400.css";
import "@fontsource/atkinson-hyperlegible-next/700.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
  section?: "wyjazdy" | "linie" | "hotele" | "bawialnie" | "gdzie" | "niezbednik";
}
const { title, description, section } = Astro.props;
const full = title === "Pieluchy i paszporty" ? title : `${title} | Pieluchy i paszporty`;
const nav = [
  { href: "/wyjazdy/", label: "Wyjazdy", id: "wyjazdy" },
  { href: "/niezbednik/", label: "Niezbędnik", id: "niezbednik" },
  { href: "/linie/", label: "Linie lotnicze", id: "linie" },
  { href: "/", label: "Hotele", id: "hotele" },
  { href: "/poznan/bawialnie/", label: "Bawialnie", id: "bawialnie" },
  { href: "/poznan/", label: "Mapa Poznania", id: "gdzie" },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Private test site: keep it out of search engines until the user decides to launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#eef6ff" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <header class="site-head">
      <div class="wrap">
        <a class="wordmark" href="/">
          <span class="wordmark-mark"><Icon name="stroller" size={20} /></span>
          Pieluchy i paszporty
        </a>
        <nav class="site-nav" aria-label="Główna">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={section === n.id ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="tresc" class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <p>
          Zasady linii, hoteli i bawialni się zmieniają. Przed rezerwacją sprawdź je u źródła: przy
          każdej informacji jest link i data sprawdzenia.
        </p>
        <p>
          Wersja testowa, niepubliczna. Stronę prowadzi autor serwisu <a
            href="https://charter-flight-deals.vercel.app/">Czarterowe okazje</a>. Nie mamy umów z
          opisanymi liniami, hotelami ani bawialniami. Lista bawialni i podkład mapy korzystają z danych <a
            href="https://www.openstreetmap.org/copyright">© OpenStreetMap</a>; mapa Poznania także z
          danych Miasta Poznań i NFZ (szczegóły pod mapą).
        </p>
      </div>
    </footer>
  </body>
</html>
