---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/atkinson-hyperlegible-next/400.css";
import "@fontsource/atkinson-hyperlegible-next/700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  section?: "linie" | "hotele";
}
const { title, description, section } = Astro.props;
const full = title === "Pieluchy i paszporty" ? title : `${title} | Pieluchy i paszporty`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Private test site: keep it out of search engines until the user decides to launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <header class="site-head">
      <div class="wrap">
        <a class="wordmark" href="/">Pieluchy i paszporty</a>
        <nav class="site-nav" aria-label="Główna">
          <a href="/linie/" aria-current={section === "linie" ? "page" : undefined}>Zasady linii</a>
          <a href="/hotele/" aria-current={section === "hotele" ? "page" : undefined}>Hotele</a>
        </nav>
      </div>
    </header>
    <main id="tresc" class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <p>
          Zasady linii i hoteli się zmieniają. Przed rezerwacją sprawdź je u źródła: każdy fakt ma
          link i datę, kiedy go sprawdziliśmy.
        </p>
        <p>
          Wersja testowa, niepubliczna. Stronę prowadzi autor serwisu
          <a href="https://charter-flight-deals.vercel.app/">Czarterowe okazje</a>. Nie mamy umów z
          liniami ani hotelami opisanymi na stronie.
        </p>
      </div>
    </footer>
  </body>
</html>
