---
// Flat illustrations drawn for this site (own work, no stock). Decorative: hidden from screen readers.
interface Props {
  name: "hero" | "plane" | "beach" | "play";
  class?: string;
}
const { name, class: cls } = Astro.props;
---

{
  name === "hero" && (
    <svg class:list={["illo", cls]} viewBox="0 0 480 380" aria-hidden="true" focusable="false">
      <circle cx="250" cy="190" r="175" fill="#D6E9FF" />
      <circle cx="380" cy="92" r="42" fill="#FFC845" />
      <g fill="#fff">
        <rect x="70" y="92" width="120" height="34" rx="17" />
        <rect x="104" y="72" width="62" height="42" rx="21" />
        <rect x="300" y="160" width="96" height="26" rx="13" />
      </g>
      <path d="M60 210 C 140 150, 220 120, 300 118" fill="none" stroke="#FF7360" stroke-width="4"
        stroke-linecap="round" stroke-dasharray="2 14" />
      <g transform="translate(296 96) rotate(-12)">
        <path d="M0 22 L70 16 C 84 15 92 20 92 26 C 92 32 84 35 70 34 L0 30 Z" fill="#17204A" />
        <path d="M34 20 L52 -6 L62 -6 L56 19 Z" fill="#12807A" />
        <path d="M34 32 L52 56 L62 56 L56 33 Z" fill="#12807A" />
        <path d="M2 22 L-6 6 L4 6 L14 21 Z" fill="#FF7360" />
        <circle cx="76" cy="25" r="3" fill="#FFC845" />
        <circle cx="64" cy="25" r="3" fill="#FFC845" />
        <circle cx="52" cy="25" r="3" fill="#FFC845" />
      </g>
      <clipPath id="hero-clip"><circle cx="250" cy="190" r="175" /></clipPath>
      <g clip-path="url(#hero-clip)">
        <path d="M40 300 C 120 270, 360 270, 450 300 L 450 380 L 40 380 Z" fill="#FFE3A3" />
        <path d="M30 318 C 70 304, 110 332, 150 318 S 230 304, 270 318 S 350 332, 390 318 S 450 304, 470 318"
          fill="none" stroke="#3FB8AA" stroke-width="8" stroke-linecap="round" />
      </g>
      <g transform="translate(110 206)">
        <rect x="0" y="22" width="78" height="64" rx="10" fill="#FF7360" />
        <rect x="26" y="8" width="26" height="18" rx="6" fill="none" stroke="#17204A" stroke-width="6" />
        <rect x="0" y="44" width="78" height="8" fill="#E85A48" />
        <circle cx="20" cy="70" r="7" fill="#FFC845" />
        <rect x="44" y="64" width="20" height="12" rx="3" fill="#fff" />
        <circle cx="16" cy="92" r="6" fill="#17204A" />
        <circle cx="62" cy="92" r="6" fill="#17204A" />
      </g>
      <g transform="translate(250 196)">
        <path d="M6 40 A 46 46 0 0 1 98 40 Z" fill="#FFC845" />
        <path d="M52 40 L52 -6 A 46 46 0 0 1 98 40 Z" fill="#12807A" />
        <rect x="4" y="40" width="96" height="30" rx="12" fill="#12807A" />
        <path d="M100 48 L126 18" stroke="#17204A" stroke-width="6" stroke-linecap="round" />
        <path d="M22 70 L14 92 M84 70 L92 92" stroke="#17204A" stroke-width="6" stroke-linecap="round" />
        <circle cx="14" cy="96" r="10" fill="#fff" stroke="#17204A" stroke-width="6" />
        <circle cx="92" cy="96" r="10" fill="#fff" stroke="#17204A" stroke-width="6" />
      </g>
      <g transform="translate(392 214)">
        <path d="M0 40 A 44 44 0 0 1 88 40 Z" fill="#fff" stroke="#FF7360" stroke-width="5" />
        <path d="M30 40 A 44 44 0 0 1 44 -4 A 44 44 0 0 1 58 40 Z" fill="#FF7360" />
        <path d="M44 40 L44 100" stroke="#17204A" stroke-width="5" stroke-linecap="round" />
      </g>
    </svg>
  )
}

{
  name === "plane" && (
    <svg class:list={["illo", cls]} viewBox="0 0 200 140" aria-hidden="true" focusable="false">
      <circle cx="150" cy="38" r="22" fill="#FFC845" />
      <rect x="18" y="30" width="70" height="20" rx="10" fill="#fff" />
      <path d="M20 112 C 60 80, 100 70, 130 66" fill="none" stroke="#FF7360" stroke-width="3"
        stroke-dasharray="2 10" stroke-linecap="round" />
      <g transform="translate(108 52) rotate(-14)">
        <path d="M0 18 L56 13 C 67 12 74 16 74 21 C 74 26 67 28 56 27 L0 24 Z" fill="#17204A" />
        <path d="M27 16 L41 -4 L49 -4 L45 15 Z" fill="#12807A" />
        <path d="M27 26 L41 46 L49 46 L45 26 Z" fill="#12807A" />
        <path d="M2 18 L-4 5 L4 5 L11 17 Z" fill="#FF7360" />
      </g>
    </svg>
  )
}

{
  name === "beach" && (
    <svg class:list={["illo", cls]} viewBox="0 0 200 140" aria-hidden="true" focusable="false">
      <circle cx="152" cy="36" r="22" fill="#FFC845" />
      <path d="M0 98 C 50 84, 150 84, 200 98 L 200 140 L 0 140 Z" fill="#FFE3A3" />
      <path d="M0 108 C 25 100, 45 116, 70 108 S 115 100, 140 108 S 180 116, 200 108" fill="none"
        stroke="#3FB8AA" stroke-width="6" stroke-linecap="round" />
      <g transform="translate(36 40)">
        <path d="M0 34 A 36 36 0 0 1 72 34 Z" fill="#fff" stroke="#FF7360" stroke-width="4" />
        <path d="M24 34 A 36 36 0 0 1 36 -2 A 36 36 0 0 1 48 34 Z" fill="#FF7360" />
        <path d="M36 34 L36 82" stroke="#17204A" stroke-width="4" stroke-linecap="round" />
      </g>
      <g transform="translate(120 70)">
        <rect x="0" y="6" width="44" height="22" rx="6" fill="#12807A" />
        <path d="M2 6 A 20 20 0 0 1 42 6 Z" fill="#FFC845" />
        <circle cx="8" cy="32" r="5" fill="#17204A" />
        <circle cx="36" cy="32" r="5" fill="#17204A" />
      </g>
    </svg>
  )
}

{
  name === "play" && (
    <svg class:list={["illo", cls]} viewBox="0 0 200 140" aria-hidden="true" focusable="false">
      <rect x="20" y="78" width="44" height="44" rx="8" fill="#FF7360" />
      <rect x="70" y="78" width="44" height="44" rx="8" fill="#12807A" />
      <rect x="45" y="30" width="44" height="44" rx="8" fill="#FFC845" />
      <text x="67" y="62" text-anchor="middle" font-family="sans-serif" font-weight="800"
        font-size="26" fill="#17204A">A</text>
      <text x="42" y="109" text-anchor="middle" font-family="sans-serif" font-weight="800"
        font-size="26" fill="#fff">B</text>
      <text x="92" y="109" text-anchor="middle" font-family="sans-serif" font-weight="800"
        font-size="26" fill="#fff">C</text>
      <circle cx="152" cy="98" r="24" fill="#D6E9FF" stroke="#17204A" stroke-width="4" />
      <path d="M134 84 C 146 94, 158 94, 170 84 M134 112 C 146 102, 158 102, 170 112" fill="none"
        stroke="#17204A" stroke-width="4" />
      <path d="M150 20 l4 9 10 1-7 7 2 10-9-5-9 5 2-10-7-7 10-1z" fill="#FFC845" />
    </svg>
  )
}
