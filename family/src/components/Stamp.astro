---
// Small source line under a fact: where it comes from and when we checked it.
import Icon from "./Icon.astro";
import { plDate, sourceLabel, type Fact } from "../lib/data";

interface Props {
  fact: Pick<Fact, "source" | "url" | "verified_at" | "to_confirm" | "due">;
  owner?: string;
}
const { fact, owner } = Astro.props;
const src = owner && fact.source === "carrier_official" ? owner : sourceLabel(fact.source);
const text = `${src}, sprawdzone ${plDate(fact.verified_at)}`;
---

<span class:list={["source", { ask: fact.to_confirm }]} data-due={fact.due}>
  <Icon name={fact.to_confirm ? "question" : "check"} size={16} />
  {
    fact.url ? (
      <a href={fact.url} rel="noopener" target="_blank">
        {text}
        <span class="visually-hidden"> (źródło, otwiera się w nowej karcie)</span>
      </a>
    ) : (
      <span>{text}</span>
    )
  }
</span>
