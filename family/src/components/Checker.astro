---
// "Pick airline + child's age -> one card of answers". Pure HTML/CSS (radio inputs + :has()),
// no JavaScript: every combination is rendered at build time and CSS shows the chosen one.
import FactTile from "./FactTile.astro";
import Icon from "./Icon.astro";
import { AGES, TOPICS, carrierName, carrierSlug, carriers, rulesFor } from "../lib/data";

const topics = TOPICS.filter((t) => carriers.some((c) => c.rules.some((r) => t.keys.includes(r.key))));
const id = (code: string, age: string) => `${code}-${age}`;
const css = carriers
  .flatMap((c) =>
    AGES.map(
      (a) =>
        `.checker:has(#l-${c.carrier_iata}:checked):has(#w-${a.id}:checked) [data-k="${id(c.carrier_iata, a.id)}"]{display:block}`,
    ),
  )
  .join("\n");
const fallback = "@supports not selector(:has(*)){.checker .answer{display:block}}";
---

<style is:inline set:html={css + "\n" + fallback}></style>
<section class="checker" aria-labelledby="sprawdz">
  <h2 id="sprawdz">Sprawdź swoją linię</h2>
  <form onsubmit="return false">
    <fieldset>
      <legend>Czym lecisz?</legend>
      <div class="chips">
        {
          carriers.map((c, i) => (
            <label class="chip">
              <input type="radio" name="linia" id={`l-${c.carrier_iata}`} checked={i === 0} />
              <span>{carrierName(c.carrier_iata)}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend>Ile lat ma dziecko?</legend>
      <div class="chips">
        {
          AGES.map((a, i) => (
            <label class="chip">
              <input type="radio" name="wiek" id={`w-${a.id}`} checked={i === 0} />
              <span>{a.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
  </form>

  {
    carriers.flatMap((c) =>
      AGES.map((a) => (
        <div class="answer" data-k={id(c.carrier_iata, a.id)} aria-live="polite">
          <h3>
            {carrierName(c.carrier_iata)}, dziecko {a.label}
          </h3>
          <ul class="tiles">
            {topics.filter((t) => a.id === "niemowle" || t.id !== "wiek").map((t) => (
              <FactTile
                facts={rulesFor(c, t.keys, a.id)}
                label={t.title}
                icon={t.icon}
                owner={carrierName(c.carrier_iata)}
                showBand={false}
                missingText="Linia tego nie podaje"
              />
            ))}
          </ul>
          <p class="more">
            <a href={`/linie/${carrierSlug(c.carrier_iata)}/`}>Wszystkie zasady {carrierName(c.carrier_iata)}</a>
          </p>
        </div>
      )),
    )
  }
  <p class="note-small" style="margin: 1rem 0 0; display: flex; gap: .4rem;">
    <Icon name="info" size={18} />
    Lecisz czarterem z biurem podróży? Cenę biletu niemowlęcia ustala biuro, a zasady bagażu i wózka
    linia, która wykonuje lot.
  </p>
</section>
