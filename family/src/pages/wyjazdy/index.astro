---
// "Wyjazdy" hub: hotels in Poland grouped by landscape, each link opening the hotel finder (/) with
// the region filter set, plus the airline pages. Counts come from the same data as the finder.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Illustration from "../../components/Illustration.astro";
import { HOTEL_FILTERS, TRIP_GROUPS, carriers, hotels, placeOf, placeRegion, tripGroupOf } from "../../lib/data";

const finder = (regions: string[], filter?: string) => {
  const q = new URLSearchParams({ r: regions.join(",") });
  if (filter) q.set("f", filter);
  return `/?${q}`;
};
// Facts worth counting per group; ids are the finder's filter ids (stable, used in URLs).
const COUNTED = ["darmowy", "bawialnia", "brodzik"].map((id) => HOTEL_FILTERS.find((f) => f.id === id)!);

for (const h of hotels) tripGroupOf(h); // build fails here if a region has no group
const groups = TRIP_GROUPS.map((g) => {
  const inGroup = hotels.filter((h) => tripGroupOf(h) === g.id);
  const regions = g.regions
    .map((r) => ({ r, n: inGroup.filter((h) => placeRegion(placeOf(h)) === r).length }))
    .filter((x) => x.n > 0);
  return {
    ...g,
    n: inGroup.length,
    regions,
    counts: COUNTED.map((f) => ({ ...f, n: inGroup.filter(f.test).length })),
  };
}).filter((g) => g.n > 0);

const hotelWord = (n: number) =>
  n === 1 ? "hotel" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "hotele" : "hoteli";
---

<Base title="Wyjazdy" section="wyjazdy" description="Wyjazdy z dzieckiem do 3 lat: hotele w Polsce nad morzem, w górach i nad jeziorami oraz zasady linii lotniczych, sprawdzone u źródła.">
  <section class="page-hero">
    <div>
      <h1>Wyjazdy z maluchem</h1>
      <p class="lead">
        Gdzie spać i czym lecieć. Tylko to, co hotele i linie same podają, z linkiem i datą sprawdzenia.
      </p>
    </div>
    <Illustration name="beach" />
  </section>

  <h2 class="section section-title">
    <span class="tile-icon"><Icon name="bed" /></span>
    Hotele w Polsce
  </h2>
  <p>
    {hotels.length} {hotelWord(hotels.length)}. Wybierz okolicę, a otworzy się wyszukiwarka z tym
    filtrem: dalej możesz ustawić dojazd z Twojego miasta i to, czego potrzebujesz.
  </p>

  <ul class="trip-groups">
    {
      groups.map((g) => (
        <li class={`trip-group ${g.tone}`}>
          <h3>
            <span class="tile-icon"><Icon name={g.icon} /></span>
            <a href={finder(g.regions.map((x) => x.r))}>{g.title}</a>
          </h3>
          <p class="trip-count">
            {g.n} {hotelWord(g.n)}
          </p>
          <ul class="trip-regions">
            {g.regions.map((x) => (
              <li>
                <a href={finder([x.r])}>{x.r}</a> <span class="note-small">({x.n})</span>
              </li>
            ))}
          </ul>
          <ul class="trip-facts">
            {g.counts.filter((c) => c.n > 0).map((c) => (
              <li>
                <Icon name={c.icon} size={18} />
                <span><a href={finder(g.regions.map((x) => x.r), c.id)}>{c.label}</a>: {c.n}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <h2 class="section section-title">
    <span class="tile-icon"><Icon name="plane" /></span>
    Lot i dokumenty
  </h2>
  <div class="doors trip-doors">
    <a class="door sea" href="/linie/">
      <Illustration name="plane" />
      <div>
        <h3>Linie lotnicze</h3>
        <p>{carriers.length} przewoźników obok siebie: opłata za niemowlę, wózek, bagaż, fotelik.</p>
      </div>
    </a>
    <a class="door coral" href="/wyjazdy/dokumenty/">
      <div>
        <h3>Dokumenty dziecka</h3>
        <p>Dowód, paszport, EKUZ i zgoda drugiego rodzica: opłaty, terminy, kto musi przyjść. Ze stron urzędowych.</p>
      </div>
    </a>
  </div>
</Base>

<style>
  .trip-groups {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    list-style: none;
    padding: 0;
    margin: 1rem 0 2.5rem;
  }
  .trip-group {
    border-radius: var(--r-panel);
    padding: 1.1rem 1.25rem 1.25rem;
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  .trip-group.sea { background: var(--sea-soft); }
  .trip-group.sun { background: var(--sun-soft); }
  .trip-group.coral { background: var(--coral-soft); }
  .trip-group h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 1.45rem;
  }
  .trip-group h3 a { color: var(--navy); }
  .trip-group .tile-icon { background: var(--white); }
  .trip-count { margin: 0; font-weight: 700; }
  .trip-regions,
  .trip-facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.2rem;
  }
  .trip-facts {
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--navy) 15%, transparent);
  }
  .trip-facts li { display: flex; align-items: flex-start; gap: 0.4rem; }
  .trip-facts li :global(svg) { flex: none; margin-top: 0.2rem; }
  .trip-doors { max-width: 50rem; }
  .trip-group a { text-underline-offset: 0.15em; }
</style>
