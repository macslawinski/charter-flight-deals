---
// Polish departure airports from a parent's point of view (data/curated/airports/*.toml).
// Facts only from each airport's own site, each with a link and the date we read it; what the site
// does not say is listed as such, never guessed.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { airportKey, data, plDate } from "../../lib/data";

const airports = [...data.airports].sort((a, b) => a.city.localeCompare(b.city, "pl"));
const latest = airports.flatMap((a) => a.facts.map((f) => f.verified_at)).sort().at(-1)!;
const keys = data.airport_keys;
for (const k of keys) airportKey(k); // build fails on a key without a label
const missing = (a: (typeof airports)[number]) =>
  keys.filter((k) => !a.facts.some((f) => f.key === k)).map((k) => airportKey(k).label.toLowerCase());
---

<Base title="Lotniska z dzieckiem" section="wyjazdy" description="Place zabaw, pokoje do przewijania, kontrola bezpieczeństwa z maluchem i wózek na sześciu polskich lotniskach, ze stron samych lotnisk.">
  <p class="crumb"><a href="/wyjazdy/">Wyjazdy</a></p>
  <section class="page-hero">
    <div>
      <h1>Lotniska z dzieckiem</h1>
      <p class="lead">
        Plac zabaw, przewijak, kontrola bezpieczeństwa z maluchem i wózek. Tylko to, co lotniska same
        piszą na swoich stronach, z linkiem i datą sprawdzenia (ostatnio {plDate(latest)}).
      </p>
    </div>
  </section>

  <nav aria-label="Lotniska">
    <ul class="toc">
      {
        airports.map((a) => (
          <li>
            <a href={`#${a.iata.toLowerCase()}`}>
              <Icon name="plane" size={18} />
              {a.city} ({a.iata})
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    airports.map((a) => {
      const gaps = missing(a);
      return (
        <section class="section" aria-labelledby={a.iata.toLowerCase()}>
          <h2 class="section-title" id={a.iata.toLowerCase()}>
            <span class="tile-icon">
              <Icon name="plane" />
            </span>
            <span>
              {a.city} <span class="iata">{a.iata}</span>
              <span class="airport-name">{a.name}</span>
            </span>
          </h2>
          <ul class="ap-facts">
            {a.facts.map((f) => {
              const k = airportKey(f.key);
              return (
                <li class:list={["ap-fact", { ask: f.to_confirm }]}>
                  <h3 class="ap-label">
                    <Icon name={k.icon} size={18} />
                    {k.label}
                  </h3>
                  {f.to_confirm && <span class="badge-ask">Do potwierdzenia</span>}
                  <p class="ap-short">{f.short}</p>
                  {f.note && <p class="ap-note">{f.note}</p>}
                  <p class="source-line">
                    <span class:list={["source", { ask: f.to_confirm }]}>
                      <Icon name={f.to_confirm ? "question" : "check"} size={16} />
                      <a href={f.url} rel="noopener" target="_blank">
                        strona lotniska, sprawdzone {plDate(f.verified_at)}
                        <span class="visually-hidden"> (źródło, otwiera się w nowej karcie)</span>
                      </a>
                    </span>
                  </p>
                </li>
              );
            })}
          </ul>
          {gaps.length > 0 && (
            <p class="ap-gaps">
              <Icon name="info" size={16} />
              <span>Strona lotniska nie podaje: {gaps.join(", ")}.</span>
            </p>
          )}
        </section>
      );
    })
  }

  <p class="ap-disclaimer">
    Zasady przewozu wózka, fotelika i jedzenia dla dziecka ustala też linia lotnicza: porównasz je na stronie
    <a href="/linie/">Linie lotnicze</a>. Udogodnienia na lotniskach się zmieniają: przed wylotem sprawdź
    je na stronie lotniska (link przy każdej informacji).
  </p>
</Base>

<style>
  .iata {
    font-size: 0.75em;
    color: var(--muted);
    font-weight: 700;
  }
  .airport-name {
    display: block;
    font-family: var(--text);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--muted);
  }
  .ap-facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .ap-fact {
    background: var(--white);
    border-radius: var(--r-tile);
    padding: 1rem 1.1rem;
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .ap-fact.ask {
    outline: 2px solid var(--sun);
  }
  .ap-fact .badge-ask {
    justify-self: start;
  }
  .ap-label {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--muted);
  }
  .ap-short {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .ap-note {
    margin: 0;
    font-size: 0.95rem;
  }
  .source-line {
    margin: 0.2rem 0 0;
  }
  .ap-gaps {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .ap-gaps :global(svg) {
    flex: none;
    margin-top: 0.2rem;
  }
  .ap-disclaimer {
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 62ch;
  }
</style>
