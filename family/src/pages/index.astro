---
import Base from "../layouts/Base.astro";
import Checker from "../components/Checker.astro";
import Icon from "../components/Icon.astro";
import Illustration from "../components/Illustration.astro";
import { carriers, data } from "../lib/data";

const hotel = data.hotels[0];
const venues = data.venues.length;
---

<Base title="Pieluchy i paszporty" description="Podróże z dzieckiem do 3 lat: zasady linii lotniczych, hotele i bawialnie, sprawdzone u źródła.">
  <section class="hero">
    <div>
      <h1>Wakacje z maluchem bez zgadywania</h1>
      <p class="lead">
        Wózek, fotelik, opłata za niemowlę, łóżeczko w hotelu. Krótkie odpowiedzi, każda ze
        źródłem.
      </p>
    </div>
    <Illustration name="hero" />
  </section>

  <Checker />

  <h2>Co jeszcze sprawdziliśmy</h2>
  <div class="doors">
    <a class="door sea" href="/linie/">
      <Illustration name="plane" />
      <div>
        <h3>Linie lotnicze</h3>
        <p>{carriers.length} przewoźników obok siebie: wózek, bagaż, fotelik.</p>
      </div>
    </a>
    <a class="door sun" href="/hotele/">
      <Illustration name="beach" />
      <div>
        <h3>Hotele</h3>
        <p>{hotel ? `${hotel.name}: łóżeczko, brodzik, bawialnia.` : "Wkrótce."}</p>
      </div>
    </a>
    <a class="door coral" href="/poznan/bawialnie/">
      <Illustration name="play" />
      <div>
        <h3>Bawialnie w Poznaniu</h3>
        <p>{venues} miejsc na deszczowy dzień: od ilu lat, ile kosztuje, kiedy otwarte.</p>
      </div>
    </a>
  </div>

  <h2>Skąd to wiemy</h2>
  <ul class="trust">
    <li>
      <span class="tile-icon"><Icon name="link" /></span>
      <span>Tylko ze stron linii, hoteli i bawialni. Przy każdej odpowiedzi jest link.</span>
    </li>
    <li>
      <span class="tile-icon"><Icon name="calendar" /></span>
      <span>Każda informacja ma datę, kiedy ją sprawdziliśmy.</span>
    </li>
    <li>
      <span class="tile-icon"><Icon name="question" /></span>
      <span>Czego źródło nie podaje, piszemy wprost. Nie zgadujemy.</span>
    </li>
  </ul>
</Base>
