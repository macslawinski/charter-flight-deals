---
import Base from "../layouts/Base.astro";
import HotelFinder from "../components/HotelFinder.astro";
import Icon from "../components/Icon.astro";
import Illustration from "../components/Illustration.astro";
import { carriers, data, hotels } from "../lib/data";
import { cityExports, cityPlaygrounds } from "../lib/map";

const venues = cityExports.reduce((n, ex) => n + cityPlaygrounds(ex).length, 0);
---

<Base title="Pieluchy i paszporty" section="hotele" description="Hotele dla rodzin z dzieckiem do 3 lat: łóżeczko, brodzik, bawialnia i dojazd z Twojego miasta, sprawdzone u źródła.">
  <section class="page-hero">
    <div>
      <h1>Hotele dla rodzin z maluchem</h1>
      <p class="lead">
        {hotels.length} hoteli. Łóżeczko, brodzik, bawialnia, dojazd z Twojego miasta. Tylko to, co
        hotel sam podaje, i lista pytań, które warto mu zadać.
      </p>
    </div>
    <Illustration name="beach" />
  </section>

  <HotelFinder />

  <h2 class="section">Co jeszcze sprawdziliśmy</h2>
  <div class="doors">
    <a class="door sea" href="/linie/">
      <Illustration name="plane" />
      <div>
        <h3>Linie lotnicze</h3>
        <p>{carriers.length} przewoźników obok siebie: opłata za niemowlę, wózek, bagaż, fotelik.</p>
      </div>
    </a>
    <a class="door coral" href="/poznan/bawialnie/">
      <Illustration name="play" />
      <div>
        <h3>Bawialnie w Poznaniu</h3>
        <p>{venues} miejsc na deszczowy dzień: od ilu lat, ile kosztuje, kiedy otwarte.</p>
      </div>
    </a>
  </div>

  <h2>Skąd to wiemy</h2>
  <ul class="trust">
    <li>
      <span class="tile-icon"><Icon name="link" /></span>
      <span>Tylko ze stron linii, hoteli i bawialni. Przy każdej odpowiedzi jest link.</span>
    </li>
    <li>
      <span class="tile-icon"><Icon name="calendar" /></span>
      <span>Każda informacja ma datę, kiedy ją sprawdziliśmy.</span>
    </li>
    <li>
      <span class="tile-icon"><Icon name="question" /></span>
      <span>Czego źródło nie podaje, piszemy wprost. Nie zgadujemy.</span>
    </li>
  </ul>
</Base>
