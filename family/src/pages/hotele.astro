---
import Base from "../layouts/Base.astro";
import Illustration from "../components/Illustration.astro";
import { FEATURE_GROUPS, data } from "../lib/data";

const total = FEATURE_GROUPS.flatMap((g) => g.keys).length;
const places = data.places
  .map((p) => ({ ...p, hotels: data.hotels.filter((h) => h.place === p.slug) }))
  .filter((p) => p.hotels.length > 0);
---

<Base title="Hotele dla rodzin z maluchem" section="hotele" description="Hotele sprawdzone pod kątem dzieci do 3 lat.">
  <section class="page-hero">
    <div>
      <h1>Hotele dla rodzin z maluchem</h1>
      <p class="lead">Tylko to, co hotel sam podaje, i lista pytań, które warto mu zadać.</p>
    </div>
    <Illustration name="beach" />
  </section>
  {
    places.map((p) => (
      <section class="section" aria-labelledby={p.slug}>
        <h2 id={p.slug}>{p.name}</h2>
        {p.region && <p class="note-small">{p.region}</p>}
        <div class="doors">
          {p.hotels.map((h) => (
            <a class="door sun" href={`/${p.slug}/${h.slug}/`}>
              <Illustration name="beach" />
              <div>
                <h3>{h.name}</h3>
                <p>
                  {new Set(h.features.map((f) => f.key)).size} z {total} rzeczy dla malucha opisane
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>
