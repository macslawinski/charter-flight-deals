---
// Side-by-side comparison of 2-4 hotels picked on /hotele/ (?h=slug,slug). The page is static: a
// compact JSON of all visible hotels is embedded and the table is built in the browser.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import {
  FEATURE_GROUPS,
  ORIGIN_CITIES,
  featureLabel,
  hotels,
  placeOf,
  placeRegion,
  short,
} from "../../lib/data";

const payload = {
  groups: FEATURE_GROUPS.map((g) => ({
    title: g.title,
    rows: g.keys.map((k) => ({ key: k, label: featureLabel(k) })),
  })),
  hotels: hotels.map((h) => {
    const place = placeOf(h);
    const access: Record<string, Record<string, number>> = {};
    for (const a of h.access.filter((a) => a.from_kind === "city")) (access[a.mode] ??= {})[a.from_code] = a.minutes;
    return {
      slug: h.slug,
      name: h.name,
      where: `${place.name}, ${placeRegion(place)}`,
      href: `/${place.slug}/${h.slug}/`,
      access,
      facts: Object.fromEntries(
        h.features.map((f) => [f.key, { t: short(f), ask: f.to_confirm }]),
      ),
    };
  }),
  total: FEATURE_GROUPS.flatMap((g) => g.keys).length,
};
---

<Base title="Porównanie hoteli" section="hotele" description="Wybrane hotele obok siebie: co podają dla dziecka do 3 lat i ile jedzie się z Twojego miasta.">
  <p class="crumb"><a href="/hotele/">Wszystkie hotele</a></p>
  <section class="page-hero">
    <div>
      <h1>Porównanie hoteli</h1>
      <p class="lead">Obok siebie to, co każdy hotel podaje na swojej stronie.</p>
    </div>
  </section>

  <p class="draft" data-none>
    <Icon name="info" />
    <span>
      Wybierz od 2 do 4 hoteli na <a href="/hotele/">liście hoteli</a> (przycisk „Porównaj” na karcie),
      a potem wróć tutaj.
    </span>
  </p>

  <div data-compare hidden>
    <form class="finder compare-from" onsubmit="return false">
      <fieldset>
        <legend>Dojazd z</legend>
        <div class="chips">
          {ORIGIN_CITIES.map((c, i) => (
            <label class="chip"><input type="radio" name="z" value={c} checked={i === 0} /><span>{c}</span></label>
          ))}
        </div>
      </fieldset>
    </form>
    <div class="compare-wrap">
      <table class="compare-table"></table>
    </div>
    <p class="note-small" data-unstated></p>
    <p class="note-small">
      „Nie podaje” znaczy, że hotel nie pisze o tym na swojej stronie, a nie że tego nie ma. Źródła i
      daty sprawdzenia są na stronie każdego hotelu. Autem: bez korków i postojów. Pociągiem: do
      najbliższej stacji, najszybsze połączenie z najwyżej 1 przesiadką.
    </p>
  </div>
  <script is:inline type="application/json" id="compare-data" set:html={JSON.stringify(payload).replace(/</g, "\\u003c")}></script>
</Base>

<script>
  import { CITY_FROM, COMPARE_MAX, MODE_LABEL, duration, saveCompare } from "../../lib/format";

  interface H {
    slug: string;
    name: string;
    where: string;
    href: string;
    access: Record<string, Record<string, number>>;
    facts: Record<string, { t: string; ask: boolean }>;
  }
  interface Payload {
    groups: { title: string; rows: { key: string; label: string }[] }[];
    hotels: H[];
    total: number;
  }
  const data = JSON.parse(document.getElementById("compare-data")!.textContent!) as Payload;
  const bySlug = new Map(data.hotels.map((h) => [h.slug, h]));
  const root = document.querySelector<HTMLElement>("[data-compare]")!;
  const table = root.querySelector<HTMLTableElement>(".compare-table")!;
  const cityForm = root.querySelector<HTMLFormElement>("form")!;

  const fromUrl = (new URLSearchParams(location.search).get("h") ?? "").split(",");
  let picked = [...new Set(fromUrl)].filter((s) => bySlug.has(s)).slice(0, COMPARE_MAX);

  try {
    const saved = localStorage.getItem("porownaj-z");
    const el = saved && cityForm.querySelector<HTMLInputElement>(`input[value="${CSS.escape(saved)}"]`);
    if (el) el.checked = true;
  } catch {
    // Storage blocked: keep the first city.
  }

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, cls?: string) => {
    const e = document.createElement(tag);
    if (text !== undefined) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  };

  function render() {
    const hs = picked.map((s) => bySlug.get(s)!);
    const enough = hs.length >= 2;
    root.hidden = !enough;
    document.querySelector<HTMLElement>("[data-none]")!.hidden = enough;
    saveCompare(picked);
    history.replaceState(null, "", picked.length ? `?h=${picked.map(encodeURIComponent).join(",")}` : location.pathname);
    if (!enough) return;

    const city = String(new FormData(cityForm).get("z"));
    table.replaceChildren();

    const head = table.createTHead().insertRow();
    head.append(el("td"));
    for (const h of hs) {
      const th = el("th");
      th.scope = "col";
      const a = el("a", h.name);
      a.href = h.href;
      const rm = el("button", "Usuń", "link-button");
      rm.type = "button";
      rm.setAttribute("aria-label", `Usuń ${h.name} z porównania`);
      rm.addEventListener("click", () => {
        picked = picked.filter((s) => s !== h.slug);
        render();
      });
      th.append(a, el("span", h.where, "note-small compare-where"), rm);
      head.append(th);
    }

    const body = table.createTBody();
    const groupRow = (title: string) => {
      const th = el("th", title, "compare-group");
      th.colSpan = hs.length + 1;
      th.scope = "colgroup";
      body.insertRow().append(th);
    };
    const row = (label: string, cell: (h: H) => HTMLTableCellElement) => {
      const tr = body.insertRow();
      const th = el("th", label);
      th.scope = "row";
      tr.append(th, ...hs.map(cell));
    };

    groupRow("Dojazd");
    for (const mode of ["car", "train"]) {
      row(`${MODE_LABEL[mode]} z ${CITY_FROM[city]}`, (h) => {
        const m = h.access[mode]?.[city];
        return m === undefined ? el("td", "nie sprawdziliśmy", "none") : el("td", duration(m), "strong");
      });
    }
    row("Opisane rzeczy dla malucha", (h) => el("td", `${Object.keys(h.facts).length} z ${data.total}`));

    const unstated: string[] = [];
    for (const g of data.groups) {
      const rows = g.rows.filter((r) => hs.some((h) => h.facts[r.key]));
      unstated.push(...g.rows.filter((r) => !rows.includes(r)).map((r) => r.label));
      if (rows.length === 0) continue;
      groupRow(g.title);
      for (const r of rows) {
        row(r.label, (h) => {
          const f = h.facts[r.key];
          if (!f) return el("td", "nie podaje", "none");
          const td = el("td", f.t);
          if (f.ask) td.append(" ", el("span", "do potwierdzenia", "badge-ask"));
          return td;
        });
      }
    }
    root.querySelector("[data-unstated]")!.textContent = unstated.length
      ? `Żaden z wybranych hoteli nie podaje: ${unstated.join(", ").toLowerCase()}. Warto o to zapytać.`
      : "";
  }

  cityForm.addEventListener("change", () => {
    try {
      localStorage.setItem("porownaj-z", String(new FormData(cityForm).get("z")));
    } catch {
      // Not critical.
    }
    render();
  });
  render();
</script>
