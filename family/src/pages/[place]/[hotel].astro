---
import Base from "../../layouts/Base.astro";
import FactTile from "../../components/FactTile.astro";
import Icon from "../../components/Icon.astro";
import Illustration from "../../components/Illustration.astro";
import {
  FEATURE_GROUPS,
  data,
  featureIcon,
  featureLabel,
  plDate,
  type Hotel,
  type Place,
} from "../../lib/data";

export function getStaticPaths() {
  return data.hotels.map((h) => {
    const place = data.places.find((p) => p.slug === h.place);
    if (!place) throw new Error(`hotel ${h.slug}: unknown place ${h.place}`);
    return { params: { place: place.slug, hotel: h.slug }, props: { h, place } };
  });
}
interface Props {
  h: Hotel;
  place: Place;
}
const { h, place } = Astro.props;
const all = FEATURE_GROUPS.flatMap((g) => g.keys);
const stated = new Set(h.features.map((f) => f.key));
const missing = all.filter((k) => !stated.has(k));
const pct = Math.round((100 * stated.size) / all.length);
const latest = h.features.map((f) => f.verified_at).sort().at(-1);
const duration = (min: number) => `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, "0")} min`;
// How we measured each mode: one caption under the table instead of the same words in every row.
const ACCESS_MODES = [
  { mode: "transfer", title: "Transferem", icon: "plane", how: "z lotniska, wg strony hotelu" },
  { mode: "car", title: "Autem", icon: "car", how: "bez korków i postojów" },
  { mode: "train", title: "Pociągiem", icon: "train", how: "do najbliższej stacji, najszybsze połączenie z najwyżej 1 przesiadką" },
] as const;
for (const a of h.access) {
  if (!ACCESS_MODES.some((m) => m.mode === a.mode)) throw new Error(`hotel ${h.slug}: no label for access mode ${a.mode}`);
}
const accessModes = ACCESS_MODES.filter((m) => h.access.some((a) => a.mode === m.mode));
// Rows: one per origin, ordered by the first mode's time (usually car).
const origins = [...new Set(
  h.access
    .filter((a) => a.mode === accessModes[0]?.mode)
    .sort((a, b) => a.minutes - b.minutes)
    .map((a) => a.from_code)
    .concat(h.access.map((a) => a.from_code)),
)];
const cell = (from: string, mode: string) => h.access.find((a) => a.from_code === from && a.mode === mode);
const accessSources = [...new Map(
  h.access.filter((a) => a.url).map((a) => [new URL(a.url!).hostname.replace(/^www\./, ""), a.url!]),
)];
const accessChecked = h.access.map((a) => a.verified_at).sort().at(-1);
const transfer = h.features.find((f) => f.key === "transfer");
const groups = FEATURE_GROUPS.map((g) => ({ ...g, keys: g.keys.filter((k) => stated.has(k)) })).filter(
  (g) => g.keys.length > 0,
);
---

<Base title={`${h.name} z dzieckiem`} section="hotele" description={`Co ${h.name} oferuje dzieciom do 3 lat, ze źródłami.`}>
  <p class="crumb"><a href="/hotele/">Wszystkie hotele</a></p>
  <section class="page-hero">
    <div>
      <h1>{h.name}</h1>
      <p class="lead">
        {place.name}{place.region && `, ${place.region}`}
      </p>
      {
        h.official_url && (
          <p>
            <a href={h.official_url} rel="noopener">Strona hotelu</a>
            {h.address && <span class="note-small"> ({h.address})</span>}
          </p>
        )
      }
    </div>
    <Illustration name="beach" />
  </section>

  <div class="score">
    <span class="score-num">{stated.size} z {all.length}</span>
    <span>rzeczy ważnych dla malucha hotel opisuje na swojej stronie</span>
    <div class="bar" role="img" aria-label={`${pct}%`}><span style={`width:${pct}%`}></span></div>
  </div>

  {
    h.status === "draft" && (
      <p class="draft" style="margin-top:1rem">
        <Icon name="info" />
        <span>
          Opis w przygotowaniu. Fakty pochodzą ze strony hotelu
          {latest && ` (sprawdzone ${plDate(latest)})`}; hotel jeszcze ich nie potwierdził.
        </span>
      </p>
    )
  }

  {
    groups.map((g) => (
      <section class="section">
        <h2>{g.title}</h2>
        <ul class="tiles">
          {g.keys.map((k) => (
            <FactTile facts={h.features.filter((f) => f.key === k)} label={featureLabel(k)} icon={featureIcon(k)} showBand={false} />
          ))}
        </ul>
      </section>
    ))
  }

  <section class="section" aria-labelledby="zapytaj">
    <h2 id="zapytaj">Zapytaj hotel przed rezerwacją</h2>
    <p>Tego strona hotelu nie podaje:</p>
    <ul class="ask-list">
      {
        missing.map((k) => (
          <li>
            <Icon name={featureIcon(k)} size={18} />
            {featureLabel(k)}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="dojazd">
    <h2 id="dojazd">Dojazd</h2>
    {
      h.access.length === 0 ? (
        <p class="note-small">
          Czasy dojazdu jeszcze sprawdzamy.
        </p>
      ) : (
        <div class="access">
          <table>
            <thead>
              <tr>
                <th scope="col">Skąd</th>
                {accessModes.map((m) => (
                  <th scope="col">
                    <span class="access-mode">
                      <Icon name={m.icon} size={18} />
                      {m.title}
                    </span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {origins.map((from) => (
                <tr>
                  <th scope="row">{from}</th>
                  {accessModes.map((m) => {
                    const a = cell(from, m.mode);
                    return a ? (
                      <td>
                        <span class="access-time">{duration(a.minutes)}</span>
                        {a.note && <span class="access-note">{a.note}</span>}
                      </td>
                    ) : (
                      <td class="access-none">–</td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
          {
            transfer && (
              <p class="access-transfer">
                <Icon name="pin" size={18} />
                <span>{transfer.note}</span>
              </p>
            )
          }
          <p class="note-small access-how">
            {accessModes.map((m) => (
              <>
                <strong>{m.title}:</strong> {m.how}.{" "}
              </>
            ))}
            {`Czasy orientacyjne${accessChecked ? `, sprawdzone ${plDate(accessChecked)}` : ""}. Źródła: `}
            {accessSources.map(([host, url], i) => (
              <>{i > 0 && ", "}<a href={url} rel="noopener">{host}</a></>
            ))}.
          </p>
        </div>
      )
    }
  </section>
</Base>
