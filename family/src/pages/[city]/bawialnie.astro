---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Illustration from "../../components/Illustration.astro";
import Stamp from "../../components/Stamp.astro";
import {
  VENUE_ORDER,
  cityName,
  data,
  forToddlers,
  short,
  venueIcon,
  venueLabel,
  type Venue,
} from "../../lib/data";

export function getStaticPaths() {
  const cities = [...new Set(data.venues.map((v) => v.city))];
  return cities.map((city) => ({
    params: { city },
    // Toddler-friendly first, then the best-documented ones.
    props: {
      city,
      venues: data.venues
        .filter((v) => v.city === city)
        .sort((a, b) => Number(forToddlers(b)) - Number(forToddlers(a)) || b.features.length - a.features.length),
    },
  }));
}
interface Props {
  city: string;
  venues: Venue[];
}
const { city, venues } = Astro.props;
const name = cityName(city);
const ordered = (v: Venue) =>
  VENUE_ORDER.flatMap((k) => v.features.filter((f) => f.key === k));
const toddlerCount = venues.filter(forToddlers).length;
---

<Base title={`Bawialnie w ${name === "Poznań" ? "Poznaniu" : name}`} section="bawialnie" description="Sale zabaw dla dzieci do 3 lat: wiek, ceny, godziny, ze źródłami.">
  <style is:inline>
    .bawialnie:has(#maluchy:checked) .venue:not([data-toddler]) { display: none; }
  </style>
  <section class="page-hero">
    <div>
      <h1>Bawialnie w Poznaniu</h1>
      <p class="lead">
        Na deszczowy dzień: od ilu lat, ile kosztuje i kiedy otwarte. Prosto ze stron bawialni.
      </p>
    </div>
    <Illustration name="play" />
  </section>

  <div class="bawialnie">
    <div class="filter">
      <label class="chip">
        <input type="checkbox" id="maluchy" />
        <span>Tylko z ofertą dla 0–3 lat ({toddlerCount})</span>
      </label>
      <span class="note-small">{venues.length} miejsc na liście</span>
    </div>

    <ul class="venues">
      {
        venues.map((v) => {
          const facts = ordered(v);
          const ask = facts.some((f) => f.to_confirm);
          return (
            <li class="venue" data-toddler={forToddlers(v) ? "" : undefined}>
              {forToddlers(v) && (
                <span class="tag-small">
                  <Icon name="blocks" size={16} />
                  Dla maluchów
                </span>
              )}
              <h3>{v.name}</h3>
              {v.address && (
                <p class="addr">
                  <Icon name="pin" size={18} />
                  {v.address}
                </p>
              )}
              <ul class="venue-facts">
                {facts.map((f) => (
                  <li>
                    <Icon name={venueIcon(f.key)} size={20} />
                    <span>
                      <span class="visually-hidden">{venueLabel(f.key)}: </span>
                      {short(f)}
                      {f.to_confirm && <> <span class="badge-ask">do potwierdzenia</span></>}
                    </span>
                  </li>
                ))}
              </ul>
              <details class="more-info">
                <summary>Szczegóły i źródła</summary>
                {facts.map((f) => (
                  <>
                    <p>
                      <strong>{venueLabel(f.key)}.</strong> {f.note}
                    </p>
                    <Stamp fact={f} />
                  </>
                ))}
                {ask && <p class="note-small">Informacje „do potwierdzenia” różnią się między źródłami.</p>}
              </details>
              {v.official_url && (
                <a href={v.official_url} rel="noopener">
                  Strona bawialni
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>

  <p class="note-small" style="margin-top:2rem">
    Listę miejsc zaczęliśmy od danych
    <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap</a> (licencja ODbL). Ceny,
    wiek i zasady bierzemy ze stron samych bawialni. Sala zabaw „Pobawimy się?” w Galerii A2 i
    Monsterkowo czekają na sprawdzenie: nie mają własnej strony z cennikiem albo jej nie znaleźliśmy.
  </p>
</Base>
