---
import Base from "../../layouts/Base.astro";
import FactTile from "../../components/FactTile.astro";
import Icon from "../../components/Icon.astro";
import Illustration from "../../components/Illustration.astro";
import { TOPICS, carrierName, carrierSlug, carriers } from "../../lib/data";

const topics = TOPICS.map((t) => ({
  ...t,
  rows: carriers.map((c) => ({ c, facts: t.keys.flatMap((k) => c.rules.filter((r) => r.key === k)) })),
})).filter((t) => t.rows.some((r) => r.facts.length > 0));
---

<Base title="Linie lotnicze z dzieckiem do 3 lat" section="linie" description="Sześć linii obok siebie: opłata za niemowlę, wózek, fotelik, bagaż. Ze źródłami.">
  <section class="page-hero">
    <div>
      <h1>Linie lotnicze obok siebie</h1>
      <p class="lead">
        {carriers.length} przewoźników, którymi najczęściej lecą czartery z Polski. Kliknij
        „Szczegóły”, żeby zobaczyć całą zasadę i źródło.
      </p>
      <p class="note-small" style="display:flex;gap:.4rem">
        <Icon name="info" size={18} />
        W czarterze cenę biletu niemowlęcia ustala biuro podróży, nie linia.
      </p>
    </div>
    <Illustration name="plane" />
  </section>

  <nav aria-label="Tematy">
    <ul class="toc">
      {
        topics.map((t) => (
          <li>
            <a href={`#${t.id}`}>
              <Icon name={t.icon} size={18} />
              {t.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    topics.map((t) => (
      <section class="section" aria-labelledby={t.id}>
        <h2 class="section-title" id={t.id}>
          <span class="tile-icon">
            <Icon name={t.icon} />
          </span>
          {t.title}
        </h2>
        <ul class="tiles">
          {t.rows.map(({ c, facts }) => (
            <FactTile
              facts={facts}
              label={carrierName(c.carrier_iata)}
              icon="plane"
              owner={carrierName(c.carrier_iata)}
              href={`/linie/${carrierSlug(c.carrier_iata)}/`}
              missingText="Linia tego nie podaje"
            />
          ))}
        </ul>
      </section>
    ))
  }
</Base>
