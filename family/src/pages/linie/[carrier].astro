---
import Base from "../../layouts/Base.astro";
import FactTile from "../../components/FactTile.astro";
import Illustration from "../../components/Illustration.astro";
import Icon from "../../components/Icon.astro";
import {
  TOPICS,
  carrierName,
  carrierSlug,
  carriers,
  plDate,
  ruleIcon,
  ruleLabel,
  type Carrier,
} from "../../lib/data";

export function getStaticPaths() {
  return carriers.map((c) => ({ params: { carrier: carrierSlug(c.carrier_iata) }, props: { c } }));
}
interface Props {
  c: Carrier;
}
const { c } = Astro.props;
const name = carrierName(c.carrier_iata);
const keys = TOPICS.flatMap((t) => t.keys);
const present = keys.filter((k) => c.rules.some((r) => r.key === k));
const missing = keys.filter((k) => !present.includes(k));
const latest = c.rules.map((r) => r.verified_at).sort().at(-1);
const sources = [...new Set(c.rules.map((r) => r.url).filter((u): u is string => !!u))];
---

<Base title={`${name} z dzieckiem`} section="linie" description={`Zasady ${name} dla dzieci do 3 lat, ze źródłami.`}>
  <p class="crumb"><a href="/linie/">Wszystkie linie</a></p>
  <section class="page-hero">
    <div>
      <h1>{name} z dzieckiem do 3 lat</h1>
      <p class="lead">
        {c.rules.length} zasad ze strony przewoźnika{latest && `, sprawdzone ${plDate(latest)}`}.
      </p>
    </div>
    <Illustration name="plane" />
  </section>

  <ul class="tiles">
    {
      present.map((k) => (
        <FactTile facts={c.rules.filter((r) => r.key === k)} label={ruleLabel(k)} icon={ruleIcon(k)} owner={name} />
      ))
    }
  </ul>

  {
    missing.length > 0 && (
      <section class="section" aria-labelledby="brak">
        <h2 id="brak">Tego {name} nie podaje</h2>
        <p>Zapytaj przewoźnika przed lotem:</p>
        <ul class="ask-list">
          {missing.map((k) => (
            <li>
              <Icon name={ruleIcon(k)} size={18} />
              {ruleLabel(k)}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section" aria-labelledby="zrodla">
    <h2 id="zrodla">Źródła</h2>
    <ul>
      {sources.map((u) => <li><a href={u} rel="noopener">{new URL(u).hostname}{new URL(u).pathname}</a></li>)}
    </ul>
  </section>
</Base>
