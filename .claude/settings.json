{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/.astro/**)",
      "Read(./**/.vercel/**)",
      "Read(./.venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./.pytest_cache/**)",
      "Read(./.ruff_cache/**)",
      "Read(./coverage/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./uv.lock)",
      "Read(./poetry.lock)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  }
}
