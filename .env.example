# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# r.pl session cookie, only if the endpoint turns out to need one
RPL_COOKIE=

# Travelpayouts (Aviasales Data API) token: travelpayouts.com -> Profile -> API token.
# Regular-airline reference prices only (python -m ingest.market).
TRAVELPAYOUTS_TOKEN=
